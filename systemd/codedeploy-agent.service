[Unit]
Description=AWS CodeDeploy Agent
Documentation=https://docs.aws.amazon.com/codedeploy/latest/userguide/
After=network-online.target
Wants=network-online.target

[Service]
# Type=simple: the master process does not double-fork. systemd tracks the
# main process directly. PID file is managed by the agent itself for the
# `status` subcommand; systemd does not need it with Type=simple.
Type=simple
# Launch through `bash -a -c`. Two behaviors depend on this exact form:
#   1. `-a` (allexport) makes bash export the variables it auto-sets — most
#      importantly BASH_EXECUTION_STRING (= the `-c` command string) — into
#      the agent's environment. Lifecycle hooks inherit the service environment
#      (see lifecycle_event/script.rs::apply_env_policy, full inheritance by
#      default), so BASH_EXECUTION_STRING reaches every hook and any shell a
#      hook spawns. Hooks may assert on its value, so the command string must
#      stay byte-for-byte as it is (do not add an `exec`, reorder, or reword it).
#   2. Sourcing /etc/profile picks up site-wide PATH/proxy/locale settings that
#      the agent has always had at startup.
ExecStart=/bin/bash -a -c '[ -f /etc/profile ] && source /etc/profile; /opt/codedeploy-agent/bin/codedeploy-agent start'
ExecStop=/opt/codedeploy-agent/bin/codedeploy-agent stop
# on-abnormal: only restart on signal/timeout/watchdog, not on clean non-zero
# exit. The master's internal respawn loop handles worker crashes; systemd
# should only intervene if the master itself is killed unexpectedly.
Restart=on-abnormal
RestartSec=10
# KillMode defaults to control-group, ensuring worker children are also
# cleaned up if the master fails to stop them gracefully.
TimeoutStopSec=7200
LimitNOFILE=65536
# Core dumps are suppressed in-process by `daemon::core_dumps::disable()`
# (gated on `disable_core_dumps: true` in the agent YAML, default true).
# We intentionally keep `LimitCORE=infinity` here — flipping it to 0 would
# force operators debugging a crashed host to also add a systemd drop-in
# just to get dumps back. With the YAML flag as the single knob, setting
# `disable_core_dumps: false` is enough. Trade-off: the in-process call is
# the sole enforcement layer; if it fails (seccomp, exotic container) the
# warning is logged and dumps proceed.
LimitCORE=infinity
MemoryAccounting=yes
SyslogIdentifier=codedeploy-agent

[Install]
WantedBy=multi-user.target
