# Cargo build output.
target/
Cargo.lock

# don't check in local env config
.cargo/*
# but track cargo-mutants config (standard location per cargo-mutants docs)
!.cargo/mutants.toml
# track cargo aliases so local dev commands stay consistent
!.cargo/config.toml

# Code coverage reports
coverage/
*.profraw
*.profdata

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Runtime PID files
test.pid

.omc/